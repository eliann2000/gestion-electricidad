# Copiar este archivo como .env y completar con tus datos (el .env NO se sube a GitHub)

# Base de datos MySQL
DATABASE_URL="mysql://root:TU_PASSWORD@localhost:3306/gestion_electricidad"

# Puerto de la API
PORT=3001

# Clave para firmar los tokens JWT (cualquier texto largo y aleatorio)
JWT_SECRET="cambiar_por_una_clave_larga_y_aleatoria"

# Envío de comprobantes por email (opcional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu_correo@gmail.com"
SMTP_PASS="contraseña_de_aplicacion"
MAIL_FROM="Sistema de Gestión <tu_correo@gmail.com>"
